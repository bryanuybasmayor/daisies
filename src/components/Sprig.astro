---
interface Props {
  class?: string;
}

// A small hand-drawn sprig, used as a section ornament (not the store's logo).
const { class: className = 'h-4 w-4' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M12 22V7" />
  <path d="M12 15c-3.6 0-6-1.9-6-5 3.6 0 6 1.9 6 5Z" />
  <path d="M12 11c3.6 0 6-1.9 6-5-3.6 0-6 1.9-6 5Z" />
  <path d="M12 7c-1.9 0-3.4-1.1-3.4-2.8C10.5 4.2 12 5.3 12 7Z" />
</svg>

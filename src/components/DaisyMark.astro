---
interface Props {
  class?: string;
}

// A small daisy motif drawn fresh for this site (not the store's logo file).
const { class: className = 'h-8 w-8' } = Astro.props;
const petals = Array.from({ length: 10 }, (_, index) => index * 36);
---

<svg
  class={className}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <g stroke="currentColor" stroke-width="1.05">
    {
      petals.map((angle) => (
        <ellipse cx="16" cy="6.6" rx="2.7" ry="5.4" transform={`rotate(${angle} 16 16)`} />
      ))
    }
  </g>
  <circle cx="16" cy="16" r="3.1" class="fill-yellow" />
</svg>

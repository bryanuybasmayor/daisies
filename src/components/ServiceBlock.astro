---
import { Image } from 'astro:assets';
import type { Service } from '../data/business';
import { serviceImages } from '../data/serviceImages';
import Button from './Button.astro';
import IconArrow from './IconArrow.astro';
import IconPhone from './IconPhone.astro';
import { withBase } from '../utils/url';

interface Props {
  service: Service;
  index: number;
}

const { service, index } = Astro.props;
const image = service.image ? serviceImages[service.image] : undefined;
---

<article
  id={service.slug}
  class="scroll-mt-6 border-t border-charcoal/12 pt-12 first:border-t-0 first:pt-0 sm:pt-16"
>
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-[0.7rem] font-semibold tracking-[0.24em] text-gold uppercase">
      Service <span class="font-serif text-[0.9rem] tracking-[0.12em]">
        {String(index).padStart(2, '0')}
      </span>
    </p>
    <h2 class="mt-3 font-serif text-[clamp(1.95rem,4vw,2.7rem)] leading-[1.04] text-teal">
      {service.name}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-[1rem] leading-relaxed text-charcoal-soft">
      {service.summary}
    </p>
  </div>

  {
    image && (
      <div class="mt-9 overflow-hidden rounded-panel bg-cream-deep shadow-[0_28px_60px_-48px_rgba(43,38,34,0.6)]">
        <Image
          src={image}
          alt={service.imageAlt ?? ''}
          widths={[420, 720, 1100]}
          sizes="(min-width: 1152px) 1100px, 92vw"
          class="aspect-[16/10] w-full object-cover"
          loading="lazy"
          format="webp"
        />
      </div>
    )
  }

  <ul class="mt-7 flex flex-wrap justify-center gap-x-7 gap-y-2.5">
    {
      service.notes.map((note) => (
        <li class="flex items-center gap-2 text-[0.9rem] leading-relaxed text-charcoal">
          <span class="h-1 w-1 rounded-full bg-gold/70" aria-hidden="true" />
          {note}
        </li>
      ))
    }
  </ul>

  {
    (service.cta || service.secondaryCta) && (
      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        {service.cta && (
          <Button href={service.cta.href}>
            <IconPhone class="h-4 w-4" />
            {service.cta.label}
          </Button>
        )}
        {service.secondaryCta && (
          <a
            href={withBase(service.secondaryCta.href)}
            class="inline-flex min-h-11 items-center gap-2 text-[0.88rem] font-semibold text-teal underline decoration-teal/35 decoration-1 underline-offset-4 transition-colors hover:text-gold hover:decoration-teal"
          >
            {service.secondaryCta.label}
            <IconArrow class="h-4 w-4" />
          </a>
        )}
      </div>
    )
  }
</article>

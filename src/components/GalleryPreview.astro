---
import { Image } from 'astro:assets';
import { homePreview } from '../data/gallery';
import Button from './Button.astro';
import IconArrow from './IconArrow.astro';
import SectionIntro from './SectionIntro.astro';
import { withBase } from '../utils/url';
---

<section aria-labelledby="gallery-preview-heading" class="bg-cream-deep">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20 lg:py-24">
    <SectionIntro
      eyebrow="A look inside"
      title="The kind of thing we make."
      intro="Fresh arrangements, permanent botanicals, wedding flowers, sympathy work, and the pieces that end up on your shelves."
      id="gallery-preview-heading"
    />

    <ul class="mt-12 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
      {
        homePreview.map((image) => (
          <li>
            <a href={withBase('/gallery')} class="group block">
              <div class="overflow-hidden rounded-soft bg-white p-2 shadow-[0_22px_45px_-40px_rgba(43,38,34,0.65)] sm:p-2.5">
                <Image
                  src={image.src}
                  alt={image.alt}
                  widths={[280, 420, 560]}
                  sizes="(min-width: 1024px) 22vw, 44vw"
                  class="aspect-[4/5] w-full rounded-[0.9rem] object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                  format="webp"
                  loading="lazy"
                />
              </div>
              <span class="mt-3 block px-1 text-center text-[0.86rem] leading-snug font-medium text-charcoal">
                {image.caption}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 flex justify-center">
      <Button href="/gallery" variant="outline">
        Visit the gallery
        <IconArrow class="h-4 w-4" />
      </Button>
    </div>
  </div>
</section>

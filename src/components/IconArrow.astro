---
interface Props {
  class?: string;
}
const { class: className = 'h-4 w-4' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M4 12h15" />
  <path d="m13.5 6.5 6 5.5-6 5.5" />
</svg>

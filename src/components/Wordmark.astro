---
import { Image } from 'astro:assets';
import logo from '../assets/images/daisieslogo.png';

interface Props {
  /** Header sits in the top bar; footer is the larger centred lockup. */
  size?: 'header' | 'footer';
  class?: string;
}

const { size = 'header', class: className = '' } = Astro.props;

// The logo is a wide single-line lockup (576 × 38), so it is sized by width to
// keep the type in proportion instead of letting a fixed height blow it up.
const widths =
  size === 'footer'
    ? 'w-[260px] sm:w-[320px]'
    : 'w-[min(320px,calc(100vw-190px))] sm:w-[320px]';
---

<span class:list={['inline-flex items-center', className]}>
  <Image
    src={logo}
    alt=""
    widths={[260, 320, 400, 576]}
    sizes={size === 'footer' ? '(min-width: 640px) 320px, 260px' : '(min-width: 640px) 320px, calc(100vw - 190px)'}
    class:list={['h-auto', widths]}
    format="webp"
    loading={size === 'header' ? 'eager' : 'lazy'}
    decoding="async"
  />
</span>

---
import { Image } from 'astro:assets';
import aboutStillLife from '../assets/images/about-still-life-tulips.jpg';
import giftwareCandles from '../assets/images/giftware-candles-linen.jpg';
import daisyPillows from '../assets/images/home-decor-daisy-pillows.jpg';
import heroShop from '../assets/images/hero-flower-shop.jpg';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import IconArrow from '../components/IconArrow.astro';
import IconPhone from '../components/IconPhone.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Sprig from '../components/Sprig.astro';
import Todo from '../components/Todo.astro';
import VisitStrip from '../components/VisitStrip.astro';
import { business } from '../data/business';
import BaseLayout from '../layouts/BaseLayout.astro';

const values = [
  {
    title: 'Service that is actually service',
    body: 'We will help you choose, we will not hover, and we will not rush you out the door. If something can be ordered in for you, we will tell you honestly.',
  },
  {
    title: 'Flowers with a point of view',
    body: 'Unique designs, made for the person rather than pulled from a catalogue. Tell us their favourite colour and we will take it from there.',
  },
  {
    title: 'One-of-a-kind decor and gifts',
    body: 'Pieces you will not see in every other store, including work from local artisans and craftsmen. If it is not in store, ask us about ordering it.',
  },
  {
    title: 'Somewhere to sit for a minute',
    body: 'A sitting area in the shop with complimentary coffee or tea, and no expectation that you buy anything today.',
  },
];
---

<BaseLayout
  title="About Us — Daisies Dreams and Decor, Melfort, SK"
  description="Meet Kyla and the small floral, home decor and gift shop on Main Street in Melfort, Saskatchewan. Unique flowers, one-of-a-kind finds and a little JOY."
>
  <PageHeader
    eyebrow="Our story"
    title="A small shop, a long-held dream, and a little JOY."
    intro="Daisies Dreams and Decor is a floral, home decor and gift shop in Melfort, Saskatchewan. It began as Kyla's dream, and it is still run on the idea that a store should make people feel welcome."
    image={heroShop}
  />

  <section aria-labelledby="story-heading" class="bg-cream">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-20 lg:py-24">
      <SectionIntro
        eyebrow="Where it started"
        title="Kyla's dream, made real on Main Street."
        id="story-heading"
      />

      <figure class="mx-auto mt-10 max-w-4xl">
        <div
          class="overflow-hidden rounded-panel bg-white p-2 shadow-[0_26px_55px_-48px_rgba(43,38,34,0.7)]"
        >
          <Image
            src={daisyPillows}
            alt="A cushion embroidered with daisies beside a vintage radio and a small vase of flowers"
            widths={[480, 800, 1100]}
            sizes="(min-width: 1024px) 896px, 92vw"
            class="aspect-[16/9] w-full rounded-[1.6rem] object-cover"
            format="webp"
            loading="lazy"
          />
        </div>
        <figcaption class="mt-3 text-center text-[0.78rem] leading-relaxed text-charcoal-soft">
          Illustrative image &middot; demo stock photo
        </figcaption>
      </figure>

      <div class="mx-auto mt-10 grid max-w-4xl gap-6 text-[1.02rem] leading-relaxed text-charcoal-soft sm:grid-cols-2 sm:gap-10">
        <p>
          Kyla always wanted a shop of her own. Not a big-box florist, and not a boutique with a
          doorman &mdash; the kind of store a small town actually uses. Flowers on the counter,
          decor on the shelves, and someone behind the counter who knows your name.
        </p>
        <p>
          Everything in the shop is chosen the same way. The flowers are designed by hand for the
          person receiving them: gorgeous, and a little different every time. The decor and gifts
          are one-of-a-kind pieces we would happily take home ourselves.
        </p>
        <p>
          The service is the part we are proudest of. We will help you find the thing, we will tell
          you honestly if we can order it in, and we will remember you the next time you come
          through the door.
        </p>
        <p>
          There is a sitting area in the store, with complimentary coffee or tea, because a shop
          should be somewhere you can stay a minute. Come in on your lunch break, or on a Saturday
          with a friend, and take your time.
        </p>
      </div>

      <figure class="mx-auto mt-12 max-w-2xl text-center">
        <Sprig class="mx-auto h-6 w-6 text-gold/60" />
        <blockquote
          class="mt-5 font-serif text-[clamp(1.6rem,3.6vw,2.3rem)] leading-[1.15] text-teal italic"
        >
          Adding a little JOY to people&rsquo;s lives &mdash; that is the whole idea.
        </blockquote>
        <figcaption class="mt-4 text-[0.7rem] font-semibold tracking-[0.24em] text-gold uppercase">
          The theme of the store
        </figcaption>
      </figure>
    </div>
  </section>

  <section aria-labelledby="care-heading" class="bg-white">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20 lg:py-24">
      <SectionIntro
        eyebrow="What we care about"
        title="Four things we will not cut corners on."
        id="care-heading"
      />

      <dl class="mt-12 grid gap-x-12 gap-y-10 sm:grid-cols-2">
        {
          values.map((value, index) => (
            <div class="border-t border-charcoal/12 pt-6">
              <dt>
                <span class="font-serif text-[0.95rem] tracking-[0.14em] text-gold" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="mt-2 block font-serif text-[1.45rem] leading-snug text-teal">
                  {value.title}
                </span>
              </dt>
              <dd class="mt-3 max-w-md text-[0.96rem] leading-relaxed text-charcoal-soft">
                {value.body}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section aria-labelledby="photos-heading" class="bg-cream-deep">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20 lg:py-24">
      <SectionIntro
        eyebrow="The shop, for now"
        title="A few pictures while we wait for the real ones."
        intro="These are illustrative photographs, not photos of the actual store. When Kyla sends over images of the shop, the workroom and the shelves, they will drop into these same spots."
        id="photos-heading"
      />

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:gap-10">
        <figure>
          <div class="overflow-hidden rounded-panel bg-white p-2.5 shadow-[0_26px_55px_-48px_rgba(43,38,34,0.7)]">
            <Image
              src={aboutStillLife}
              alt="Tulips in a glass vase beside an open book in warm afternoon light"
              widths={[320, 480, 640]}
              sizes="(min-width: 768px) 45vw, 90vw"
              class="aspect-[4/5] w-full rounded-[1.5rem] object-cover"
              format="webp"
              loading="lazy"
            />
          </div>
          <figcaption class="mt-3 text-center text-[0.78rem] leading-relaxed text-charcoal-soft">
            Illustrative image &middot; demo stock photo
          </figcaption>
        </figure>

        <figure class="sm:mt-12">
          <div class="overflow-hidden rounded-panel bg-white p-2.5 shadow-[0_26px_55px_-48px_rgba(43,38,34,0.7)]">
            <Image
              src={giftwareCandles}
              alt="Candles, stoneware cups and eucalyptus arranged on linen and a wooden tray"
              widths={[320, 480, 640]}
              sizes="(min-width: 768px) 45vw, 90vw"
              class="aspect-[4/5] w-full rounded-[1.5rem] object-cover"
              format="webp"
              loading="lazy"
            />
          </div>
          <figcaption class="mt-3 text-center text-[0.78rem] leading-relaxed text-charcoal-soft">
            Illustrative image &middot; demo stock photo
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="hours" aria-labelledby="hours-heading" class="scroll-mt-6 bg-cream">
    <div class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-20 lg:py-24">
      <div class="rounded-panel bg-white px-6 py-10 text-center shadow-[0_30px_60px_-55px_rgba(43,38,34,0.7)] sm:px-12 sm:py-14">
        <Eyebrow label="When we are open" />
        <h2 id="hours-heading" class="mt-4 font-serif text-display leading-[1.05] text-teal">
          Store hours.
        </h2>
        <p class="mx-auto mt-4 max-w-md text-[0.98rem] leading-relaxed text-charcoal-soft">
          We are open six days a week. If you are making a special trip, or need flowers for a
          sympathy service, a quick call ahead is always a good idea.
        </p>

        <ul class="mx-auto mt-8 max-w-sm border-t border-charcoal/12 text-left">
          {
            business.hours.map((entry) => (
              <li class="flex items-baseline justify-between gap-4 border-b border-charcoal/12 py-2.5">
                <span class="text-[0.98rem] text-charcoal">{entry.day}</span>
                <span
                  class:list={[
                    'text-right text-[0.98rem]',
                    entry.closed ? 'text-charcoal-soft' : 'font-medium text-charcoal',
                  ]}
                >
                  {entry.display}
                </span>
              </li>
            ))
          }
        </ul>

        <p class="mx-auto mt-4 max-w-sm text-[0.85rem] leading-relaxed text-charcoal-soft">
          Some public directories list a different set of hours. These are the store&rsquo;s own
          posted hours, so please call ahead for anything time-sensitive.
        </p>

        <div class="mt-6 flex flex-wrap justify-center gap-2">
          <Todo note="which hours set is current" />
        </div>

        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <Button href={business.phone.href}>
            <IconPhone class="h-4 w-4" />
            Call {business.phone.display}
          </Button>
          <Button href="/contact" variant="outline">
            Contact us
            <IconArrow class="h-4 w-4" />
          </Button>
        </div>
      </div>
    </div>
  </section>

  <VisitStrip />
</BaseLayout>

---
import '@fontsource-variable/cormorant-garamond';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/karla';
import '../styles/global.css';
import BusinessSchema from '../components/BusinessSchema.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  ogType = 'website',
} = Astro.props;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#11504d" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:site_name" content="Daisies Dreams and Decor" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <BusinessSchema />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-[3px] focus:bg-cream focus:px-4 focus:py-3 focus:text-teal focus:shadow-lg"
    >
      Skip to main content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
